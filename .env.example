# Copy to .env.local (and set the same values in Vercel).
RESEND_API_KEY=re_xxxxxxxx
# Segment that holds confirmed subscribers (Resend dashboard → Segments).
RESEND_SEGMENT_ID=
# Topics (Resend dashboard → Topics). Everyone who confirms is opted into both;
# posts email the first, projects the second, and subscribers can leave either alone.
RESEND_POSTS_TOPIC_ID=
RESEND_PROJECTS_TOPIC_ID=
# Must be on a domain verified in Resend.
RESEND_FROM="John Doe <mail@example.com>"
# Random string used to sign confirmation links: openssl rand -base64 32
SUBSCRIBE_SECRET=
# Optional override, no trailing slash. Defaults to https://nathanielendick.dev;
# set it to http://localhost:3000 only to click confirmation links against a local server.
# SITE_URL=
